# ==========================================
# VeraFi Backend Configuration
# ==========================================

# Google Gemini API Key (Get a free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini vision model used for ledger OCR (optional, defaults to gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Database URL (Optional: defaults to local verafi.db in the backend folder)
DATABASE_URL=sqlite:///verafi.db
